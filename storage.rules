rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Allow any authenticated user to read all files
    match /{allPaths=**} {
      allow read: if request.auth != null;
    }

    // Allow users to upload to their own post directory
    match /posts/{userId}/{fileName} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow users to upload their own avatar
    match /avatars/{userId}/{fileName} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow admins to upload event images
    match /events/{fileName} {
      allow write: if request.auth != null && (
        request.auth.token.email == 'brunovujcec6@gmail.com' || 
        request.auth.token.email == 'ismael.hadzic17@gmail.com'
      );
    }
  }
}
