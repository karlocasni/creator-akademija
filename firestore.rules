rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ───────────────────────────────────────────────────────────────

    function isAuthed() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthed() && request.auth.uid == uid;
    }

    function myProfilePath() {
      return /databases/$(database)/documents/profiles/$(request.auth.uid);
    }

    function myProfile() {
      return get(myProfilePath()).data;
    }

    // Admins are marked with isAdmin on their profile (only an admin can set it)
    function isAdmin() {
      return isAuthed() && exists(myProfilePath()) && myProfile().get('isAdmin', false) == true;
    }

    function isCreator() {
      return isAuthed() && exists(myProfilePath()) && myProfile().get('isCreator', false) == true;
    }

    function isStaff() {
      return isAdmin() || isCreator();
    }

    // A paying member: profile activated by an admin
    function isMember() {
      return isAdmin() || (isAuthed() && exists(myProfilePath()) && myProfile().get('status', 'inactive') == 'active');
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function onlyChanges(keys) {
      return changedKeys().hasOnly(keys);
    }

    // The set of uids added to / removed from a list field is exactly the caller
    function togglesOwnUid(field) {
      let before = resource.data.get(field, []).toSet();
      let after = request.resource.data.get(field, []).toSet();
      return after.difference(before).union(before.difference(after)) == [request.auth.uid].toSet();
    }

    // A like counter moves by exactly the change of its uid list (legacy docs
    // that stored the uids in the counter field get the list size).
    function counterFollowsList(listField, countField) {
      let before = resource.data.get(listField, []).toSet();
      let after = request.resource.data.get(listField, []).toSet();
      let old = resource.data.get(countField, 0);
      let next = request.resource.data.get(countField, 0);
      return (old is number && next == old + after.size() - before.size()) ||
        (!(old is number) && next == after.size());
    }

    function isStorageUrlOrNull(v) {
      return v == null || (v is string && v.matches('^https://firebasestorage[.]googleapis[.]com/.*'));
    }

    // ─── profiles ──────────────────────────────────────────────────────────────
    // status / roles / access dates are admin-only; XP can only grow a little per write.

    function profileLockedKeys() {
      return ['status', 'isAdmin', 'isCreator', 'accessUntil', 'offsetDays', 'createdAt', 'email', 'uid'];
    }

    function levelOk() {
      return !changedKeys().hasAny(['level']) || (
        request.resource.data.level is int &&
        request.resource.data.level >= 1 && request.resource.data.level <= 10
      );
    }

    function xpChangeOk() {
      return !changedKeys().hasAny(['xp']) || (
        request.resource.data.xp is number &&
        request.resource.data.xp >= resource.data.get('xp', 0) &&
        request.resource.data.xp <= resource.data.get('xp', 0) + 500
      );
    }

    match /profiles/{userId} {
      allow read: if isOwner(userId) || isMember();

      allow create: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.get('status', 'inactive') == 'inactive' &&
        request.resource.data.get('isAdmin', false) == false &&
        request.resource.data.get('isCreator', false) == false &&
        !('accessUntil' in request.resource.data) &&
        !('offsetDays' in request.resource.data) &&
        !('email' in request.resource.data) &&
        request.resource.data.get('xp', 0) == 0
      );

      allow update: if isAdmin() || (
        isOwner(userId) &&
        !changedKeys().hasAny(profileLockedKeys()) &&
        xpChangeOk() && levelOk()
      ) || (
        // mentors grading a submission award the student +100 XP
        isStaff() && onlyChanges(['xp', 'level']) &&
        request.resource.data.xp == resource.data.get('xp', 0) + 100 && levelOk()
      );

      allow delete: if isAdmin();
    }

    // Private account data (email) — never on the member-readable profile
    match /accounts/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.keys().hasOnly(['email', 'updatedAt']) &&
        request.resource.data.email == request.auth.token.email.lower()
      );
      allow delete: if isAdmin();
    }

    // ─── posts ─────────────────────────────────────────────────────────────────

    match /posts/{postId} {
      allow read: if isMember();

      allow create: if isMember() &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.keys().hasOnly(['authorId', 'authorName', 'authorAvatar', 'content', 'title', 'category', 'imageUrl', 'videoUrl', 'commentsCount', 'createdAt']) &&
        request.resource.data.content is string && request.resource.data.content.size() <= 5000 &&
        request.resource.data.get('title', '') is string && request.resource.data.get('title', '').size() <= 200 &&
        request.resource.data.commentsCount == 0 &&
        request.resource.data.createdAt == request.time &&
        isStorageUrlOrNull(request.resource.data.get('imageUrl', null)) &&
        isStorageUrlOrNull(request.resource.data.get('videoUrl', null));

      allow update: if isAdmin() ||
        // author edits their own text/media
        (isMember() && resource.data.authorId == request.auth.uid &&
          onlyChanges(['content', 'title', 'category', 'imageUrl', 'videoUrl', 'updatedAt']) &&
          isStorageUrlOrNull(request.resource.data.get('imageUrl', null)) &&
          isStorageUrlOrNull(request.resource.data.get('videoUrl', null))) ||
        // anyone commenting moves the counter by exactly one
        (isMember() && onlyChanges(['commentsCount']) &&
          (request.resource.data.commentsCount == resource.data.get('commentsCount', 0) + 1 ||
           request.resource.data.commentsCount == resource.data.get('commentsCount', 0) - 1));

      allow delete: if isAdmin() || (isAuthed() && resource.data.authorId == request.auth.uid);

      match /likes/{userId} {
        allow read: if isMember();
        allow create: if isMember() && isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /comments/{commentId} {
        allow read: if isMember();

        allow create: if isMember() &&
          request.resource.data.authorId == request.auth.uid &&
          request.resource.data.get('content', '') is string &&
          request.resource.data.get('content', '').size() <= 2000 &&
          request.resource.data.get('likedBy', []).size() == 0 &&
          request.resource.data.get('likes', 0) == 0;

        allow update: if isAdmin() ||
          (isAuthed() && resource.data.authorId == request.auth.uid && onlyChanges(['content', 'updatedAt'])) ||
          (isMember() && onlyChanges(['likedBy', 'likes']) && togglesOwnUid('likedBy') &&
            counterFollowsList('likedBy', 'likes'));

        allow delete: if isStaff() ||
          (isAuthed() && resource.data.authorId == request.auth.uid);
      }
    }

    // ─── events ────────────────────────────────────────────────────────────────

    match /events/{eventId} {
      allow read: if isMember();
      allow create: if isAdmin() || (isCreator() && request.resource.data.creatorId == request.auth.uid);
      allow update: if isAdmin() ||
        (isCreator() && resource.data.get('creatorId', '') == request.auth.uid && !changedKeys().hasAny(['creatorId']));
      allow delete: if isAdmin() || (isCreator() && resource.data.get('creatorId', '') == request.auth.uid);

      match /rsvps/{userId} {
        allow read: if isMember();
        allow create, update: if isMember() && isOwner(userId);
        allow delete: if isOwner(userId) || isStaff();
      }
    }

    // ─── chats ─────────────────────────────────────────────────────────────────

    function isChatParticipant(chatId) {
      return isAuthed() &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    match /chats/{chatId} {
      // resource == null lets the client check whether a DM already exists
      allow read: if isAuthed() && (resource == null || request.auth.uid in resource.data.participants);

      allow create: if isMember() &&
        request.resource.data.participants is list &&
        request.resource.data.participants.size() == 2 &&
        request.auth.uid in request.resource.data.participants &&
        (chatId == request.resource.data.participants[0] + '_' + request.resource.data.participants[1] ||
         chatId == request.resource.data.participants[1] + '_' + request.resource.data.participants[0]);

      allow update: if isAuthed() &&
        request.auth.uid in resource.data.participants &&
        onlyChanges(['lastMessage', 'lastMessageTime', 'lastMessageSenderId']) &&
        request.resource.data.lastMessageSenderId == request.auth.uid;

      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isChatParticipant(chatId);
        allow create: if isMember() &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.get('text', '') is string &&
          request.resource.data.get('text', '').size() <= 4000 &&
          isChatParticipant(chatId);
        allow update: if isChatParticipant(chatId) && onlyChanges(['read']);
      }
    }

    // ─── notifications ─────────────────────────────────────────────────────────

    match /notifications/{notifId} {
      allow read, delete: if isAuthed() && resource.data.recipientId == request.auth.uid;
      allow update: if isAuthed() && resource.data.recipientId == request.auth.uid && onlyChanges(['read']);
      allow create: if isMember() &&
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.recipientId is string &&
        request.resource.data.recipientId != 'all' &&
        request.resource.data.get('message', '') is string &&
        request.resource.data.get('message', '').size() <= 500;
    }

    // ─── challenges ────────────────────────────────────────────────────────────

    match /challenges/{challengeId} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    match /challengeSubmissions/{submissionId} {
      allow read: if isMember();
      allow create: if isMember() &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.get('isPinned', false) == false &&
        request.resource.data.get('likes', []).size() == 0 &&
        request.resource.data.get('likeCount', 0) == 0 &&
        request.resource.data.get('videoLink', '') is string &&
        request.resource.data.get('videoLink', '').matches('^https?://.*');
      allow update: if isAdmin() ||
        (isAuthed() && resource.data.authorId == request.auth.uid && onlyChanges(['description', 'videoLink']) &&
          request.resource.data.get('videoLink', '').matches('^https?://.*')) ||
        (isMember() && onlyChanges(['likes', 'likeCount']) && togglesOwnUid('likes') &&
          request.resource.data.get('likeCount', 0) == resource.data.get('likeCount', 0) +
            request.resource.data.get('likes', []).size() - resource.data.get('likes', []).size());
      allow delete: if isAdmin() || (isAuthed() && resource.data.authorId == request.auth.uid);
    }

    // ─── submissions (Predaja i ocjena videa) ──────────────────────────────────
    // Students see their own; everyone sees graded + public ones; staff grade.

    function submissionEditableKeys() {
      return ['description', 'isPublic', 'videoLink', 'lectureId', 'lectureTitle', 'updatedAt'];
    }

    match /submissions/{submissionId} {
      allow read: if isStaff() ||
        (isAuthed() && resource.data.userId == request.auth.uid) ||
        (isMember() && resource.data.status == 'graded' && resource.data.isPublic == true);

      allow create: if isMember() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.keys().hasOnly(['userId', 'username', 'userAvatar', 'lectureId', 'lectureTitle', 'videoLink', 'videoPath', 'description', 'isPublic', 'status', 'createdAt']) &&
        request.resource.data.videoLink is string &&
        request.resource.data.videoLink.matches('^https://.*') &&
        request.resource.data.get('description', '').size() <= 2000;

      allow update: if isStaff() ||
        (isAuthed() && resource.data.userId == request.auth.uid && (
          // before grading the student may edit everything they submitted
          (resource.data.status == 'pending' && onlyChanges(submissionEditableKeys()) &&
            request.resource.data.videoLink.matches('^https://.*')) ||
          // afterwards only the public/private switch
          onlyChanges(['isPublic'])
        ));

      allow delete: if isStaff() || (isAuthed() && resource.data.userId == request.auth.uid);
    }

    // ─── courses ───────────────────────────────────────────────────────────────

    match /courses/{courseId} {
      allow read: if isMember();
      allow write: if isStaff();
    }

    // ─── discordWaitlist ───────────────────────────────────────────────────────
    // Landing-page waitlist form: visitors (logged out too) may add themselves,
    // only admins can read or clean up the list.

    match /discordWaitlist/{entryId} {
      allow create: if request.resource.data.keys().hasOnly(['discordName', 'fullName', 'email', 'createdAt']) &&
        request.resource.data.email is string &&
        request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$') &&
        request.resource.data.email.size() <= 200 &&
        request.resource.data.fullName is string && request.resource.data.fullName.size() <= 120 &&
        request.resource.data.discordName is string && request.resource.data.discordName.size() <= 80 &&
        request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // ─── hookVault ─────────────────────────────────────────────────────────────

    match /hookVault/{hookId} {
      allow read: if isMember();
      allow create: if isMember() &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.get('likedBy', []).size() == 0 &&
        request.resource.data.get('likes', 0) == 0;
      allow update: if isAdmin() ||
        (isAuthed() && resource.data.authorId == request.auth.uid &&
          !changedKeys().hasAny(['authorId', 'likes', 'likedBy', 'createdAt'])) ||
        (isMember() && onlyChanges(['likes', 'likedBy']) && togglesOwnUid('likedBy') &&
          counterFollowsList('likedBy', 'likes'));
      allow delete: if isAdmin() || (isAuthed() && resource.data.authorId == request.auth.uid);
    }

    // ─── videoIdeas / savedTrends (private per user) ───────────────────────────

    match /videoIdeas/{ideaId} {
      allow read, delete: if isAuthed() && resource.data.userId == request.auth.uid;
      allow create: if isMember() && request.resource.data.userId == request.auth.uid;
    }

    match /savedTrends/{trendId} {
      allow read, delete: if isAuthed() && resource.data.userId == request.auth.uid;
      allow create: if isMember() && request.resource.data.userId == request.auth.uid;
    }
  }
}
